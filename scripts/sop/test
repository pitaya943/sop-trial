#!/bin/sh
# Test interface (docs/sop/ci-contract.md section 4): run every test and write
# JUnit XML to build/sop/junit.xml. Must work on a clean ubuntu-24.04 runner.
#
# pytest goes into a local virtualenv: the system Python refuses plain
# "pip install" there (PEP 668, externally managed environment).
set -e
cd "$(dirname "$0")/../.."
if [ ! -x .venv/bin/python ]; then
  python3 -m venv .venv
  .venv/bin/python -m pip install --quiet pytest==9.1.1
fi
mkdir -p build/sop
exec .venv/bin/python -m pytest -q -p no:cacheprovider --junitxml=build/sop/junit.xml tests
